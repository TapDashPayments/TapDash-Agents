    {
      "id": "pa-park-money",
      "name": "Park: QuickBooks money move",
      "type": "branch",
      "enabled": true,
      "timeout": "50ms",
      "max_attempts": 1,
      "config": {
        "when": {
          "id": "a97a4099-e533-412e-b98a-eb993e51e6f2",
          "all": [
            {
              "id": "59642196-100d-4e70-84e8-29e58b78a2fa",
              "field": "/agent/slug",
              "operator": "equals",
              "value": "proto-agents"
            },
            {
              "id": "df576a44-a244-42e3-b530-7648106a56db",
              "field": "/request/server",
              "operator": "equals",
              "value": "park:quickbooks"
            },
            {
              "id": "5141edc9-bdb1-4204-9e09-0ca6c4b3387f",
              "field": "/request/tool",
              "operator": "regex",
              "value": "^mcp__wh__quickbooks__(create|update|delete)[_-](payment|bill_payment|transfer|deposit|journal_entry|refund_receipt|sales_receipt|credit_memo|vendor_credit|purchase|invoice|bill)$"
            }
          ]
        },
        "blocks": [
          {
            "id": "pa-park-money-outcome",
            "name": "Park: QuickBooks money move",
            "type": "outcome",
            "enabled": true,
            "timeout": "50ms",
            "max_attempts": 1,
            "config": {
              "outcome": "human",
              "reason": "Parked durable-park action: approve to let the agent run it exactly once.",
              "escalation_path": "notify-yaakov-yehuda"
            }
          }
        ]
      }
    },
