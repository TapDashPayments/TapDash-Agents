    {
      "id": "money-server-human",
      "name": "Money server: always a person",
      "type": "branch",
      "enabled": true,
      "timeout": "50ms",
      "max_attempts": 1,
      "config": {
        "when": {
          "id": "6348fb15-f38b-4d00-b87d-81f96cd95923",
          "any": [
            {
              "id": "e2f3dd1f-c7e0-4f1f-85c5-ff2959928884",
              "field": "/request/server",
              "operator": "regex",
              "value": "^(.*[:_.-])?(quickbooks|qbo|intuit|xero|stripe|paypal|venmo|square|plaid|braintree|adyen|wise|mercury|brex|ramp|bill[._-]?com|melio|payoneer|dwolla|moov|maverick|accept[._-]?blue|authorize[._-]?net|authnet|ach|wire|treasury)([:_.-].*)?$"
            },
            {
              "id": "a2a0ea5e-1e40-4d65-8553-b7461bbe88df",
              "field": "/request/server",
              "operator": "regex",
              "value": "^.*(pay|bank|stripe|quickbooks|treasury|billing|invoic|ledger|wallet|money|finance).*$"
            },
            {
              "id": "ecc5ca1a-379b-47ec-bcc0-ce7724c98109",
              "field": "/request/tool",
              "operator": "regex",
              "value": "^(.*__)?[A-Za-z0-9_-]*?(quickbooks|qbo|intuit|xero|stripe|paypal|venmo|plaid|braintree|adyen|mercury|brex|melio|payoneer|dwolla|maverick|accept[._-]?blue|authorize[._-]?net|authnet|pay|bank|stripe|quickbooks|treasury|billing|invoic|ledger|wallet|money|finance)[A-Za-z0-9_-]*?__.*$"
            },
            {
              "id": "71ddc42c-8254-47a8-8691-7795cd9521b5",
              "field": "/request/tool",
              "operator": "regex",
              "value": "^(.*__)?(.*[_-])?(pay|payment|payments|payout|transfer|wire|refund|charge|withdraw|withdrawal|deposit|remit|disburse|send_money|ach)([_-].*)?$"
            }
          ]
        },
        "blocks": [
          {
            "id": "money-server-human-outcome",
            "name": "Money server: always a person",
            "type": "outcome",
            "enabled": true,
            "timeout": "50ms",
            "max_attempts": 1,
            "config": {
              "outcome": "human",
              "reason": "Tool on a payments or accounting (QuickBooks) server, or a money-moving name: money never auto-approves; a person decides.",
              "escalation_path": "notify-yaakov-yehuda"
            }
          }
        ]
      }
    },
