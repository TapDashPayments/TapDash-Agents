# durable-park gateway bridge: the withHuman pipeline webhook block (POST /wh/bridge on 127.0.0.1:8791).
# System unit, installed, enabled and started by deploy/configure_hermes.sh, together with its socket unit
# durable-park-bridge.socket (which holds the port) and the system user dpbridge.
#
# OWN USER: the bridge runs as dpbridge, not as the bot's user hermes. dpbridge has no login, no home and no group
# but its own, so nothing the bot runs can signal this process or read its memory, and nothing it runs can bind
# the port (the socket unit holds it, also while this service restarts). The separate uid is what protects the
# bridge. ProtectProc=invisible does the reverse: it hides other users' processes from the bridge.
#
# NO START LIMIT: with Accept=no, systemd puts the socket unit into the failed state (service-start-limit-hit) and
# closes its listening socket when this service trips its start limit, and that frees 127.0.0.1:8791 for anyone.
# The default (5 starts in 10 s) trips after about 6 s of a persistent start failure with RestartSec=1, so
# StartLimitIntervalSec=0 below keeps systemd retrying every second instead (systemd.unit(5)).
#
# STATELESS: the bridge keeps no state and does not open the ledger (the ledger is a file the bot's user can
# write, so a row in it proves nothing). For every gateway call it asks withHuman itself (GET /api/v1/requests)
# with the organization key /etc/durable-park/audit_key (permissions audit.read, request.read,
# request.read.unrouted: it can read requests and cannot approve, deny or change anything) and approves only a
# call that matches one approved, consumed park request in the last 120 s that no other gateway request has
# already used. Anything unclear answers human.
# That is why there is no DURABLE_PARK_LEDGER and no ReadWritePaths: the bridge writes nothing.
#
# SECRETS: systemd reads /etc/durable-park/bridge_secret (root:root 0600) and /etc/durable-park/audit_key
# (root:hermes 0640) as root and hands the bridge private copies (LoadCredential, %d = the credentials directory).
# The copies are made when the service starts, so rotating either key needs `sudo systemctl restart
# durable-park-bridge`; the socket keeps the port during the restart.
# /opt/durable-park is the receiver's venv (starlette, uvicorn, agentapprovalprotocol, httpx) and holds root-owned
# copies of this repo's bridge/ and plugin/durable_park/ (configure_hermes.sh).
[Unit]
Description=durable-park gateway bridge (withHuman approval webhook block)
Requires=durable-park-bridge.socket
After=durable-park-bridge.socket network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=dpbridge
Group=dpbridge
WorkingDirectory=/opt/durable-park
Environment=PYTHONPATH=/opt/durable-park/plugin:/opt/durable-park
Environment=PYTHONUNBUFFERED=1
LoadCredential=bridge_secret:/etc/durable-park/bridge_secret
LoadCredential=audit_key:/etc/durable-park/audit_key
ExecStart=/opt/durable-park/bin/python -B -m bridge.app --systemd-socket --secret-file %d/bridge_secret --key-file %d/audit_key --expected-agent proto-agents
Restart=always
RestartSec=1

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
