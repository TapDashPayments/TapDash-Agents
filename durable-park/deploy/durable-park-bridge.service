# durable-park gateway bridge: the withHuman pipeline webhook block (POST /wh/bridge on 127.0.0.1:8791).
# System unit, installed, enabled and started by deploy/configure_hermes.sh (which also creates dpwake).
#
# LEDGER PATH: the deployed plugin's ledger is /home/hermes/.hermes/plugin-data/durable-park/ledger.db
# (DURABLE_PARK_LEDGER below; ReadWritePaths is its directory, which also holds the -wal/-shm files and the
# bridge's bridge_deliveries.db). The directory must exist before the unit starts, and the bridge refuses to
# create a missing ledger file (it answers human and logs once), so a wrong path cannot create an empty one.
# /opt/durable-park is the receiver's venv (starlette, uvicorn, agentapprovalprotocol) and holds root-owned
# copies of this repo's bridge/ and plugin/durable_park/ (configure_hermes.sh).
[Unit]
Description=durable-park gateway bridge (withHuman approval webhook block)
After=network.target

[Service]
Type=simple
# hermes: it must read and write the ledger (the bridge records the one-time gateway pass in it).
User=hermes
Group=hermes
# dpwake: read access to /etc/durable-park/bridge_secret (0640 root:dpwake).
SupplementaryGroups=dpwake
WorkingDirectory=/opt/durable-park
Environment=PYTHONPATH=/opt/durable-park/plugin:/opt/durable-park
Environment=PYTHONUNBUFFERED=1
Environment=DURABLE_PARK_LEDGER=/home/hermes/.hermes/plugin-data/durable-park/ledger.db
ExecStart=/opt/durable-park/bin/python -B -m bridge.app --host 127.0.0.1 --port 8791 --secret-file /etc/durable-park/bridge_secret --expected-agent proto-agents
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/plugin-data/durable-park
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
