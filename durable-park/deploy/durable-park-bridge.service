# durable-park gateway bridge: the withHuman pipeline webhook block (POST /wh/bridge on 127.0.0.1:8791).
# System unit; lives in the repo only. The controller installs it at deploy (Task 7 Step 5):
#   sudo groupadd --system dpwake   # if the group does not exist yet
#   sudo install -m 0644 deploy/durable-park-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now durable-park-bridge
#
# DEPLOY-TIME VALUES (R4): set DURABLE_PARK_LEDGER and ReadWritePaths to the real ledger location (the
# directory that holds ledger.db; the bridge also keeps bridge_deliveries.db next to it).
# /opt/durable-park is assumed to hold a venv (venv/) with starlette + uvicorn and a copy/checkout of this
# repo's bridge/ and plugin/ directories.
[Unit]
Description=durable-park gateway bridge (withHuman approval webhook block)
After=network.target

[Service]
Type=simple
# hermes: it must read and write the ledger (the bridge records the one-time gateway pass in it).
User=hermes
Group=hermes
# dpwake: read access to /etc/durable-park/bridge_secret (0640 root:dpwake).
SupplementaryGroups=dpwake
WorkingDirectory=/opt/durable-park
Environment=PYTHONPATH=/opt/durable-park/plugin:/opt/durable-park
Environment=PYTHONUNBUFFERED=1
Environment=DURABLE_PARK_LEDGER=/home/hermes/.hermes/durable-park/ledger.db
ExecStart=/opt/durable-park/venv/bin/python -m bridge.app --host 127.0.0.1 --port 8791 --secret-file /etc/durable-park/bridge_secret --expected-agent proto-agents
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/durable-park
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
