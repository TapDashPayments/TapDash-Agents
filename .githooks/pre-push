#!/bin/sh
# Refuse a push whose code changes come without the doc changes they need (see CONTRIBUTING.md).
# Enable once per clone:  git config core.hooksPath .githooks
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -eu
ROOT=$(git rev-parse --show-toplevel)
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue    # deleting a branch
    base=$remote_sha
    if [ "$base" = "$ZERO" ]; then            # new branch: compare with what the remote's main already has
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$ZERO")
    fi
    python3 "$ROOT/tools/docs_check/check_docs.py" --base "$base" --head "$local_sha" || status=1
    python3 "$ROOT/tools/docs_check/check_docs.py" --verify-map --head "$local_sha" || status=1
done
exit $status
